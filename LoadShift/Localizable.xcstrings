    "Scenario %lld: %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szenario %1$lld: %2$@"
          }
        }
      }
    },
    "Serve the users reliably – at least 99 % of the requests in time (SLA) – and emit less CO₂ than the reference operator, who simply leaves every server on." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bediene die Nutzer zuverlässig – mindestens 99 % der Requests rechtzeitig (SLA) – und stoße weniger CO₂ aus als der Referenzbetreiber, der einfach alle Server laufen lässt."
          }
        }
      }
    },
    "Servers on (mean)" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server an (Mittel)"
          }
        }
      }
    },
